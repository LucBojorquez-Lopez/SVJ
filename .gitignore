# Build products
src/generate_events/svj_regression
# Same reason as above: a compiled binary bakes in absolute library paths from
# the machine that built it, so a committed one is useless anywhere else.
src/generate_events/svj_regression_delphes
src/generate_events/svj_delphes_test

# Locally built PYTHIA / FastJet, if $SVJ_WORK is placed inside a clone.
# The default is a sibling of the repo, so this is belt-and-braces.
svj-work/

# Notebooks — the GUI is driven from a scratch notebook per user
*.ipynb

# Cluster job logs.  Condor writes these to $SVJ_AFS/logs on AFS, not here
# (docs/lxplus.md §7.2) — this entry only catches stray local runs.
logs/

# Python bytecode / test cache
__pycache__/
*.py[cod]
.pytest_cache/

# Large regenerable simulation outputs.
# Raw TSVs run to tens of MB each and are the single biggest source of git
# history bloat in this repo — they are reproducible from the binary plus a
# cfg, so they stay out of version control.  Use -f to force-add a small one
# you deliberately want to ship as a fixture.
simulated/tsv/*.tsv
simulated/svj/*_raw.npz
simulated/tsv/report_figures/
simulated/tsv/play_around/
simulated_smoke/

# Per-job validation shards from condor/validation.sub.  merge_svj_validation.py
# folds these 16 x 125 points into simulated/svj/validation_production.npz, which
# IS tracked -- the shards add nothing once merged.  Note the underscore: this
# pattern deliberately cannot match the merged file itself.
simulated/svj/validation_production_*.npz

# Ad-hoc validate_fit.py outputs.  That script requires an explicit --out, so
# these are always deliberate one-offs, not part of a working example.
simulated/svj/validation_fit*.npz
