# condor/tsv.sub — batch TSV generation, 4 independent shards
#
#   source setup_env.sh
#   condor_submit condor/tsv.sub
#   bash merge_svj_tsv.sh 4            # after all jobs finish
#
# Run condor/smoke.sub FIRST (docs/lxplus.md §7.3).
#
# Each shard gets a distinct seed_offset, so PYTHIA seeds never overlap.
# Total events = queue N x nEvent (from svj_regression.cfg).
# Set request_cpus to nWorkers in svj_regression.cfg.
#
# Shards land in simulated/tsv/ inside the repo — tens of MB each.  Redirect
# tsv_file / tsv_kin_file in svj_regression.cfg for anything large
# (docs/lxplus.md §8).

include : condor/_common.inc

arguments = "tsv 4 $(ProcId)"

output = $(SVJ_AFS_DIR)/logs/tsv_$(ClusterId)_$(ProcId).out
error  = $(SVJ_AFS_DIR)/logs/tsv_$(ClusterId)_$(ProcId).err
log    = $(SVJ_AFS_DIR)/logs/tsv_$(ClusterId).log

request_cpus   = 16
request_memory = 2 GB
request_disk   = 8 GB
+JobFlavour    = "longlunch"

queue 4
