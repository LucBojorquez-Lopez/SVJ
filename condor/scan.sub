# condor/scan.sub — parameter scan, 16 parallel slices
#
#   source setup_env.sh
#   condor_submit condor/scan.sub
#   python src/run_regression/scan_svj.py --merge --n-jobs 16   # after all done
#
# Run condor/smoke.sub FIRST (docs/lxplus.md §7.3) — it is one espresso job and
# validates the EOS/worker-node plumbing this file depends on.
#
# N_JOBS must agree in three places: the `arguments` line, `queue`, and the
# --merge call above.  Set n_outer_workers in scan_regression.cfg to
# request_cpus.
#
# --merge reads simulated/svj/ unconditionally and ignores output_dir, so leave
# output_dir at its default `simulated` unless you also merge by hand.

include : condor/_common.inc

arguments = "scan 16 $(ProcId)"

output = $(SVJ_AFS_DIR)/logs/scan_$(ClusterId)_$(ProcId).out
error  = $(SVJ_AFS_DIR)/logs/scan_$(ClusterId)_$(ProcId).err
log    = $(SVJ_AFS_DIR)/logs/scan_$(ClusterId).log

request_cpus   = 16
request_memory = 4 GB
request_disk   = 4 GB
+JobFlavour    = "tomorrow"

queue 16
