# SM background generation -- see docs/backgrounds.md.
#
# 17 samples x 20 shards x 50k events = 17M events, ~47 core-hours at the
# measured Delphes rate of ~100 ev/s.  One core per job and a short flavour,
# for the reason recorded in lxplus.md section 9: a 16-core request does not
# schedule on this farm.
include : condor/_common.inc

arguments = "background 1 $(SHARD)"
environment = "SVJ_REPO=$(SVJ_REPO_DIR) SVJ_BG_SAMPLE=$(SAMPLE) SVJ_BG_BINARY=svj_regression SVJ_BG_OUT=/eos/user/l/lbojorqu/svj/background/tsv_truth"

output = $(SVJ_AFS_DIR)/logs/bgtruth_$(SAMPLE)_$(ClusterId)_$(SHARD).out
error  = $(SVJ_AFS_DIR)/logs/bgtruth_$(SAMPLE)_$(ClusterId)_$(SHARD).err
log    = $(SVJ_AFS_DIR)/logs/bgtruth_$(ClusterId).log

request_cpus   = 1
request_memory = 2 GB
request_disk   = 4 GB
+JobFlavour    = "workday"


# Truth-level counterpart for the QCD slices only (2026-09-07).
#
# Purpose: QCD's "MET" is jet-based missing HT, and it is NOT zero at truth
# level -- jets below vis_jet_pt_min, jets outside ETA_MAX and unclustered soft
# radiation all leak into it.  A 2000-event local test gave a truth median of
# 25 GeV with 10.4% above 100 GeV.  Without this stream we cannot separate that
# definition effect from genuine detector mismeasurement, and the "QCD fraction
# is a detector readout" reasoning in normalisation.md stays an assertion.
#
# Same cfgs as the Delphes stream -- svj_regression ignores delphes_card -- so
# process, slice boundaries and cross sections are identical by construction.
# Only the six QCD samples: the real-MET backgrounds do not have this ambiguity.
queue SAMPLE, SHARD from (
qcd_pt100_200, 0
qcd_pt100_200, 1
